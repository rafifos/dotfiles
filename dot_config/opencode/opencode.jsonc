{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "deepwiki": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/sse"
    },
    "dev-tools": {
      "enabled": true,
      "type": "local",
      "command": ["go", "run", "github.com/sammcj/mcp-devtools@HEAD"],
      "environment": {
        "NOTE": "The below environment variables are completely optional, see the README.md for available tools and configuration options",
        "ENABLE_ADDITIONAL_TOOLS": "shadcn,memory,process_document,excel,aws_documentation,terraform_documentation,security,sequential-thinking,api,filesystem"
      }
    }
  }
}
